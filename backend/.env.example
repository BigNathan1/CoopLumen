# CoopLumen Backend Configuration
# 
# Required on all environments: PORT, DATABASE_URL, STELLAR_NETWORK, STELLAR_HORIZON_URL, FRONTEND_URL
# Required only in production (NODE_ENV=production): AUTH_SESSION_SECRET, ADMIN_ADDRESSES
#
# Never commit this file with real values to git. Use a .env.local or secret management tool
# for production deployments.

PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://cooplumen:cooplumen@localhost:5432/cooplumen

# PostgreSQL Pool Configuration (production hardening)
PGPOOL_MAX=10                    # Maximum number of connections in pool
PGPOOL_IDLE_TIMEOUT=30000       # Idle connection timeout in milliseconds (30s)
PGPOOL_CONNECTION_TIMEOUT=2000  # Connection timeout in milliseconds (2s)

# Stellar Network Configuration
# REQUIRED: Must be either "testnet" or "mainnet"
STELLAR_NETWORK=testnet

# Stellar Horizon URL
# REQUIRED: Horizon endpoint for the selected network
# Default (testnet): https://horizon-testnet.stellar.org
# Mainnet: https://horizon.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Stellar Distributor Account (Optional)
# The only account the server may sign transactions for (community distributor).
# Leave unset to disable server-side signing entirely.
STELLAR_DISTRIBUTOR_PUBLIC_KEY=

# Shared secret for verifying the HMAC-SHA256 signature on incoming
# POST /api/v1/webhooks/stellar requests. 
# REQUIRED in production; requests are rejected with 503 when unset.
STELLAR_WEBHOOK_SECRET=

# Shared secret for third-party KYC callbacks sent to POST /api/v1/webhooks/kyc.
# Keep this separate from the Stellar event webhook secret.
KYC_WEBHOOK_SECRET=

# Frontend origin (for CORS)
# REQUIRED: Must match the domain your frontend is served from
FRONTEND_URL=http://localhost:3000

# Secret used to sign wallet session tokens issued by POST /api/v1/auth/verify.
# REQUIRED in production (NODE_ENV=production); falls back to an insecure development 
# default when unset in development mode.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=

# Redis (Optional)
# Backs the price and balance caches and the shared rate limit and slow-down counters.
# When unset:
#   - Caches fall back to in-process tier
#   - Rate limiting falls back to per-process memory
#   - A warning is logged
# Set it in any multi-instance deployment so limits hold across instances.
# If Redis is unreachable at request time, rate limiting fails open.
REDIS_URL=redis://localhost:6379

# Number of trusted reverse-proxy hops in front of the API (e.g. 1 behind a
# single load balancer). Required for per-IP rate limits to see the real client
# address; leave unset when the API is exposed directly.
TRUST_PROXY=

# Testnet end-to-end suites are skipped unless this is set to 1.
# They fund throwaway accounts through Friendbot and submit real transactions,
# so they need network access and take minutes rather than seconds.
STELLAR_TESTNET_E2E=

# Friendbot URL for Testnet account funding
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org

# Admin Authorization
# REQUIRED in production (NODE_ENV=production).
# Comma-separated list of Stellar public addresses allowed to call operator-only routes
# (currently GET /api/v1/tokens to list all tokens).
# 
# If unset or empty:
#   - In development: a warning is logged; operator routes still fail with 403
#   - In production: the application will not start (fails during validation)
#
# Example: GXXXX...,GYYY...,GZZZ...
# 
# Generate test key: soroban keys generate --default cooplumen-admin && soroban keys address --name cooplumen-admin
ADMIN_ADDRESSES=

# Mainnet-Specific Configuration (Optional, used when STELLAR_NETWORK=mainnet)
#
# Mainnet Governance Contract Address
# The deployed Soroban governance contract on Stellar Mainnet.
# Leave unset for Testnet; required (and verified to start with 'C') on Mainnet.
STELLAR_MAINNET_GOVERNANCE_CONTRACT_ID=

# Mainnet Issuer Public Key
# The Stellar account that issues the community governance token on Mainnet.
# Leave unset for Testnet; required on Mainnet.
STELLAR_MAINNET_ISSUER_PUBLIC_KEY=
