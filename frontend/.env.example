# Backend API origin, without a trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Stellar network the wallet signs for: TESTNET or PUBLIC.
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET

# Optional. Locale rendered before the user's saved choice is read: en or sw.
# Unrecognised values fall back to en.
# NEXT_PUBLIC_DEFAULT_LOCALE=en
